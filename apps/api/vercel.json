{
  "version": 2,
  "installCommand": "cd ../..; pnpm install --frozen-lockfile",
  "buildCommand": "cd ../..; pnpm --filter @nexus/api build",
  "functions": {
    "api/health.js": {
      "runtime": "@vercel/node@5.0.0",
      "maxDuration": 30
    },
    "api/index.ts": {
      "runtime": "@vercel/node@5.0.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
