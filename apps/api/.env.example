NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_command_center
JWT_ACCESS_SECRET=change-me-access-secret
