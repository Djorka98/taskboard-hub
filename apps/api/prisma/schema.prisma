generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  member
}

enum TaskStatus {
  todo
  in_progress
  blocked
  completed
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum NotificationType {
  task_updated
  event_created
  system_message
  layout_saved
}

enum ActivityEntityType {
  task
  event
  note
  notification
  dashboard_layout
  widget_preference
  auth
}

enum WidgetType {
  kpi_summary
  tasks_overview
  upcoming_events
  activity_feed
  notes
  notifications_summary
  performance_chart
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  fullName          String
  passwordHash      String
  role              UserRole           @default(member)
  avatarUrl         String?
  themePreference   String?            @default("dark")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  refreshTokens     RefreshToken[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  events            Event[]
  notes             Note[]
  notifications     Notification[]
  activityLogs      ActivityLog[]      @relation("ActivityActor")
  dashboardLayout   DashboardLayout?
  widgetPreferences WidgetPreference[]
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(todo)
  priority    TaskPriority  @default(medium)
  startDate   DateTime?
  dueDate     DateTime?
  assigneeId  String?
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  tags        TaskTag[]
  activities  ActivityLog[] @relation("TaskActivity")

  @@index([assigneeId])
  @@index([creatorId])
  @@index([status, priority])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks     TaskTag[]
}

model TaskTag {
  taskId    String
  tagId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Event {
  id              String     @id @default(cuid())
  userId          String
  title           String
  description     String?
  category        String
  startsAt        DateTime
  endsAt          DateTime?
  reminderMinutes Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities      ActivityLog[] @relation("EventActivity")

  @@index([userId, startsAt])
}

model Note {
  id          String        @id @default(cuid())
  userId      String
  title       String
  content     String
  color       String?
  label       String?
  pinned      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  ActivityLog[] @relation("NoteActivity")

  @@index([userId, pinned])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  ActivityLog[]    @relation("NotificationActivity")

  @@index([userId, readAt])
}

model ActivityLog {
  id              String            @id @default(cuid())
  actorId         String
  action          String
  entityType      ActivityEntityType
  taskId          String?
  eventId         String?
  noteId          String?
  notificationId  String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  actor           User              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  task            Task?             @relation("TaskActivity", fields: [taskId], references: [id], onDelete: SetNull)
  event           Event?            @relation("EventActivity", fields: [eventId], references: [id], onDelete: SetNull)
  note            Note?             @relation("NoteActivity", fields: [noteId], references: [id], onDelete: SetNull)
  notification    Notification?     @relation("NotificationActivity", fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
}

model DashboardLayout {
  id          String      @id @default(cuid())
  userId      String      @unique
  layout      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WidgetPreference {
  id          String      @id @default(cuid())
  userId      String
  widgetId    WidgetType
  visible     Boolean     @default(true)
  order       Int         @default(0)
  width       Int         @default(4)
  height      Int         @default(3)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetId])
  @@index([userId, order])
}
